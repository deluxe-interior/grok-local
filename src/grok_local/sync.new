from __future__ import annotations

import logging
from dataclasses import dataclass
from pathlib import Path
from typing import Any

from .client import GrokClient, GrokClientError
from .config import AccountConfig

logger = logging.getLogger(__name__)


@dataclass
class SyncSummary:
    pages: int = 0
    conversations_seen: int = 0
    responses_seen: int = 0
    assets_seen: int = 0
    downloaded: int = 0
    errors: int = 0


def sync_account(
    account: AccountConfig,
    *,
    full: bool = False,
    limit_conversations: int | None = None,
    page_limit: int = 40,
    download: bool = True,
    download_concurrency: int = 6,
) -> SyncSummary:
    # Determine storage directory based on account alias or fallback
    output_path = Path(f"./archive_output/{getattr(account, 'alias', 'default')}")
    output_path.mkdir(parents=True, exist_ok=True)
    
    summary = SyncSummary()

    with GrokClient(account=account) as client:
        # Step 1: Fetch all assets from /rest/assets and map them by conversationId
        asset_map: dict[str, list[dict[str, Any]]] = {}
        asset_page_token = ""
        
        while True:
            try:
                asset_data = client.asset_list(
                    pageToken=asset_page_token, 
                    pageSize=page_limit, 
                    includeImagineFiles=True
                )
                summary.pages += 1
            except GrokClientError as e:
                logger.error(f"Failed to fetch asset list: {e}")
                summary.errors += 1
                break

            assets = asset_data.get("assets", [])
            if not assets:
                break

            for asset in assets:
                summary.assets_seen += 1
                conv_id = asset.get("rootAssetSourceConversationId") or "unmapped"
                if conv_id not in asset_map:
                    asset_map[conv_id] = []
                asset_map[conv_id].append(asset)

            asset_page_token = asset_data.get("nextPageToken", "")
            if not asset_page_token or not full:
                break

        # Step 2: Fetch conversations and coordinate downloads mapped from asset library
        conv_page_token = ""
        while True:
            try:
                data = client.conversation_list(pageToken=conv_page_token, pageSize=page_limit)
                summary.pages += 1
            except GrokClientError as e:
                logger.error(f"Failed to fetch conversation list: {e}")
                summary.errors += 1
                break

            conversations = data.get("conversations", [])
            if not conversations:
                break

            for conv in conversations:
                if limit_conversations is not None and summary.conversations_seen >= limit_conversations:
                    break

                summary.conversations_seen += 1
                conv_id = conv.get("conversationId")
                if not conv_id:
                    continue

                conv_dir = output_path / conv_id
                conv_dir.mkdir(parents=True, exist_ok=True)

                # Process assets mapped to this conversation
                conv_assets = asset_map.get(conv_id, [])
                for asset in conv_assets:
                    media_url = "https://assets.grok.com/" + asset.get("key") or asset.get("downloadUrl")

                    asset_id = asset.get("assetId") or "asset"
                    print (media_url)
                    if media_url:
                        ext = Path(media_url).suffix or ".png"
                        local_dest = conv_dir / f"{asset_id}{ext}"
                        if download and not local_dest.exists():
                            try:
                                client.download_asset(media_url, str(local_dest))
                                summary.downloaded += 1
                            except GrokClientError as e:
                                logger.error(f"Failed to download asset {asset_id}: {e}")
                                summary.errors += 1

            if limit_conversations is not None and summary.conversations_seen >= limit_conversations:
                break

            conv_page_token = data.get("nextPageToken", "")
            if not conv_page_token or not full:
                break

    return summary
